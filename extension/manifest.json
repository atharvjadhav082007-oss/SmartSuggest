{
  "manifest_version": 3,
  "name": "SmartSuggest • Email & Grammar Assistant",
  "version": "1.0.0",
  "description": "Real-time grammar, spell checking & auto-complete for Gmail, Outlook, and web forms powered by high-performance C++ OOP engine.",
  "permissions": [
    "activeTab",
    "storage"
  ],
  "host_permissions": [
    "http://localhost:8080/*"
  ],
  "action": {
    "default_popup": "popup.html",
    "default_title": "SmartSuggest Assistant"
  },
  "content_scripts": [
    {
      "matches": [
        "https://mail.google.com/*",
        "https://outlook.live.com/*",
        "https://outlook.office.com/*",
        "https://outlook.office365.com/*",
        "http://*/*",
        "https://*/*"
      ],
      "js": ["content.js"],
      "css": ["content.css"],
      "run_at": "document_idle"
    }
  ]
}
